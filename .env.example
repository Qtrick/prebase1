# Google Apps Script web app deployment URL that receives waitlist submissions.
# See docs/WAITLIST_SETUP.md and src/lib/waitlist-config.ts
VITE_WAITLIST_ENDPOINT=https://script.google.com/macros/s/AKfycbyOV8LwyfAB_tQ9W-3dOC41LH4gM7frZ7LTzQ-ltNqzci5rlWO5K6gHRLYUNTlIlXEr/exec

# Cloudflare Turnstile site key (public). Default is in src/lib/turnstile-config.ts.
# VITE_TURNSTILE_SITE_KEY=0x4AAAAAAEfhQHv5YzRsO9yI

# Local development only: fake a successful submission without an endpoint.
# Skips Turnstile as well. Leave unset (or false) in production.
# VITE_WAITLIST_MOCK=true
